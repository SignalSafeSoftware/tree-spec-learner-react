{
    "name": "@signalsafe/tree-spec-learner-react",
    "version": "0.1.0",
    "type": "module",
    "description": "UI-kit agnostic React learner view for SignalSafe TreeSpec decision trees.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SignalSafeSoftware/tree-spec-learner-react.git"
    },
    "bugs": {
        "url": "https://github.com/SignalSafeSoftware/tree-spec-learner-react/issues"
    },
    "homepage": "https://github.com/SignalSafeSoftware/tree-spec-learner-react#readme",
    "keywords": [
        "tree-spec",
        "decision-tree",
        "learner",
        "training",
        "react",
        "signalsafe"
    ],
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "LICENSE",
        "SECURITY.md"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "yarn@1.22.22",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "docs:images": "yarn build && node docs/demo/generate-doc-images.mjs",
        "docs:check": "node docs/demo/generate-doc-images.mjs --check",
        "lint": "yarn typecheck",
        "typecheck": "tsc --noEmit",
        "pack:local": "npm pack --pack-destination ../../dist/reusable-npm",
        "release:check": "node ../../scripts/run-private-package-release-checks.mjs --mode prepublish",
        "release:verify": "node ../../scripts/run-private-package-release-checks.mjs --mode postpublish",
        "publish:preflight": "node ../../scripts/check-private-registry-preflight.mjs --scope @signalsafe",
        "publish:dry-run": "npm publish --dry-run",
        "publish:verify": "node ../../scripts/check-private-package-postpublish.mjs --scope @signalsafe --package @signalsafe/tree-spec-learner-react --version $npm_package_version",
        "pack:check": "node ../../scripts/check-package-tarball.mjs --tgz \"../../dist/reusable-npm/signalsafe-tree-spec-learner-react-$npm_package_version.tgz\" --expect package/dist/index.js --expect package/dist/index.d.ts --expect package/package.json --expect package/README.md",
        "smoke:package": "node scripts/smoke-package.mjs",
        "prepublishOnly": "npm run build",
        "prepare": "npm run build",
        "test": "vitest run",
        "test:coverage": "yarn test --coverage"
    },
    "dependencies": {
        "@signalsafe/simulator-core": "^0.1.8"
    },
    "peerDependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    },
    "devDependencies": {
        "@signalsafe/tree-spec": "^0.3.3",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@types/react-test-renderer": "^18.3.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-test-renderer": "^18.3.1",
        "typescript": "^7.0.2",
        "@vitest/coverage-v8": "^3.2.4",
        "vitest": "^3.2.4"
    }
}
